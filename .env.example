# ------------------------------------------------------------------
# KanDeck environment configuration
# Copy this file to `.env` and adjust. `.env` is gitignored — keep it that way.
# ------------------------------------------------------------------

# Server
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# Where the flat-file store lives (bind-mounted in Docker)
DATA_DIR=./data

# Session signing secret. REQUIRED in production and must be strong:
#   openssl rand -base64 32
# The app refuses to start in production if this is unset/default/<32 chars.
JWT_SECRET=change-me-to-a-long-random-string

# Encrypts secrets at rest (the SMTP password). Optional but
# recommended — decoupling it from JWT_SECRET lets you rotate the session secret
# without making stored secrets undecryptable. If blank, JWT_SECRET is used.
#   openssl rand -base64 32
SECRETS_KEY=

# Public base URL of this app (e.g. https://kandeck.example.com). Optional, but
# set it if KanDeck sits behind a reverse proxy/tunnel: it's used for links in
# notifications and for the calendar-feed (.ics) URLs shown in Board settings.
APP_URL=

# Behind a reverse proxy / Cloudflare Tunnel? Set to 1 so login rate-limiting
# sees real client IPs and HTTPS is detected. Leave blank if exposed directly.
TRUST_PROXY=

# Optional one-time secret required to create the first login. Without it,
# first-run setup only works from a direct local-network request.
SETUP_TOKEN=

# Session lifetime
SESSION_TTL=7d

# Static API key / bearer token for external tools (n8n, webhooks, etc.).
# You can also generate/manage a key in the app (App Settings -> API).
API_KEY=

# ---- Notifications ----
# Email (SMTP) and Discord notifications are configured in the app
# (App Settings -> Notifications), not via env vars.

# ---- Backups ----
# Backup frequency and retention are configured in the app
# (App Settings -> Backups). The values below are only pre-UI fallbacks.
BACKUP_CRON=0 3 * * 0
BACKUP_RETENTION=12
