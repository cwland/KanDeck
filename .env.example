# ------------------------------------------------------------------
# KanDeck environment configuration
# Copy this file to `.env` and adjust. `.env` is gitignored.
# ------------------------------------------------------------------

# Server
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# Where the flat-file store lives (bind-mounted in Docker)
DATA_DIR=./data

# Session signing secret (CHANGE THIS to a long random string in production)
JWT_SECRET=change-me-to-a-long-random-string
# Session lifetime
SESSION_TTL=7d

# Static API key / bearer token for external tools (n8n, webhooks, etc.)
API_KEY=change-me-api-key

# ---- Notifications (optional; leave blank to disable) ----
# SMTP email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=KanDeck <no-reply@example.com>
SMTP_TO=

# Discord webhook
DISCORD_WEBHOOK_URL=

# ---- Backups ----
# Cron schedule for automated backups (default: weekly, Sunday 03:00)
BACKUP_CRON=0 3 * * 0
BACKUP_RETENTION=12
