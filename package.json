{
  "name": "kandeck",
  "version": "2.9.1",
  "description": "KanDeck — a flat-file, self-hosted Kanban app with a REST API, theming, and notifications.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --watch src --ext js,json,html,css,mjs src/server.js",
    "backup": "node src/services/backup.js --once",
    "reset-password": "node src/reset-password.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.13"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "license": "MIT"
}
